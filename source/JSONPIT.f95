!
SUBROUTINE JSONPIT
!
!     THIS SUBROUTINE PRINTS THE SYSTEM STATE TO A JSON FORMATTED FILE
!     SIMILAR TO THE SUB PRINT.  IN SIMULATIONS WHERE A TYPE 4 HEAT SINK
!     SUMMARY IS PERFORMED AT THE VERY END OF THE SIMULATION,
!     AN ADDITIONAL JSON PRINT IS MADE.  THIS IS DONE SO THAT THE NEW
!     AIR AND WALL TEMPS, THAT RESULT FROM SUB DTHTS2 IN UNCONTROLLED
!     ZONES, ARE CAPTURED IN THE JSON FILE. IN THESE SITUATIONS, THE
!     PENTULTIMATE JSON PRINT WILL BE EQUIVALENT TO LAST DETAILED/ABBV
!     PRINT IN THE STANDARD OUTPUT FILE.  THE LAST PIT, IN THIS CASE,
!     REPRESENTS WHAT WOULD BE PRINTED TO A TYPE 5 RESTART (RST) FILE,
!     IF ONE WAS REQUESTED.
!
INCLUDE 'DSHARE'
!
!     CONSTANTS
INTEGER*4 NPASSENGERS
INTEGER*4 ZERO
INTEGER*4 NSEGMENTS
INTEGER*4 LASTPIT
REAL REALZERO
!
!     BEGIN JSON OUTPUT LIST
1200 FORMAT ( T5, '[')
1220 FORMAT ( T5, ']')
1240 FORMAT ( T5, '],')
!     BEGIN AND END OF PIT OBJECT
1300 FORMAT ( T10, '{')
1320 FORMAT ( T10, '}')
1340 FORMAT ( T10, '},')
1400 FORMAT ( T10, '[')
1420 FORMAT ( T10, ']')
1440 FORMAT ( T10, '],')
1500 FORMAT ( T10, '"Pit" : ', T60, F10.2, ',')
1600 FORMAT ( T25, '{')
1700 FORMAT ( T25, '}')
1720 FORMAT ( T25, '},')
1800 FORMAT ( T25, '[')
1900 FORMAT ( T25, ']')
1920 FORMAT ( T25, '],')
2000 FORMAT ( T10, '"Train_Data" : ')
2020 FORMAT ( T10, '"Train_Data" : [],')
2100 FORMAT ( T10, '"Section_Data" : ')
2110 FORMAT ( T10, '"Section_Data" : [],')
2200 FORMAT ( T10, '"Segment_Data" : ')
2210 FORMAT ( T10, '"Segment_Data" : [],')
2300 FORMAT ( T10, '"Subsegment_Data" : ')
2310 FORMAT ( T10, '"Subsegment_Data" : []')
!     TRAIN ITEMS
2400 FORMAT ( T25, '"Train_Number" : ', T60, I10, ',')
2402 FORMAT ( T25, '"Train_Short_ID" : ', T66,'"', A2,'"', ',')
2405 FORMAT ( T25, '"Train_Type_Number" : ', T60, I10, ',')
2410 FORMAT ( T25, '"Route_Number" : ', T60, I10, ',')
2415 FORMAT ( T25, '"Location" : ', T60, F10.2, ',')
2420 FORMAT ( T25, '"Speed" : ', T60, F10.2, ',')
2425 FORMAT ( T25, '"Accel" : ', T60, F10.2, ',')
2430 FORMAT ( T25, '"Mode" : ', T60, I10, ',')
2435 FORMAT ( T25, '"Total_Drag" : ', T60, F10.2, ',')
2440 FORMAT ( T25, '"Air_Drag" : ', T60, F10.2, ',')
2445 FORMAT ( T25, '"Tractive_Effort" : ', T60, F10.2, ',')
2450 FORMAT ( T25, '"Air_Drag_Coeff" : ', T60, F10.2, ',')
2455 FORMAT ( T25, '"Motor_Current" : ', T60, F10.2, ',')
2460 FORMAT ( T25, '"Line_Current" : ', T60, F10.2, ',')
2465 FORMAT ( T25, '"Fly_Wheel" : ', T60, F10.3, ',')
2466 FORMAT ( T25, '"Heat_Gen" : ', T60, F10.3, ',')
2467 FORMAT ( T25, '"Heat_Reject" : ', T60, F10.3, ',')
2470 FORMAT ( T25, '"Grid_Temp_Accel" : ', T60, F10.2, ',')
2472 FORMAT ( T25, '"Grid_Temp_Decel" : ', T60, F10.2, ',')
2474 FORMAT ( T25, '"Aux_Power" : ', T60, F10.2, ',')
2476 FORMAT ( T25, '"Propulsion_Power" : ', T60, F10.2, ',')
2478 FORMAT ( T25, '"Regeneration_Power" : ', T60, F10.2, ',')
2480 FORMAT ( T25, '"Flywheel_Power" : ', T60, F10.2, ',')
2482 FORMAT ( T25, '"Accel_Grid_Heat_In" : ', T60, F10.3, ',')
2484 FORMAT ( T25, '"Decel_Grid_Heat_In" : ', T60, F10.3, ',')
2486 FORMAT ( T25, '"Rolling_Resistance_Heat" : ', T60, F10.3, ',')
2488 FORMAT ( T25, '"Propulsion_Heat_Released" : ', T60, F10.3, ',')
2490 FORMAT ( T25, '"Aux_Heat_Released_Sensible" : ', T60, F10.3, ',')
2492 FORMAT ( T25, '"Aux_Heat_Released_Latent" : ', T60, F10.4, ',')
2494 FORMAT ( T25, '"Passengers" : ', T60, I10)
!     SECTION DATA
2500 FORMAT ( T25, '"Section" : ',T70 , I3, ',')
2505 FORMAT ( T25, '"Airflow" : ', T60, F11.3, ',')
2510 FORMAT ( T25, '"Buoyancy" : ', T60, F10.5, ',')
2515 FORMAT ( T25, '"Pressure_Change" : ', T60, F10.5)
!     SEGMENT DATA
2600 FORMAT ( T25, '"Segment" : ', T60, I10, ',')
2601 FORMAT ( T25, '"Segment" : ', T60, I10, ',')
2602 FORMAT ( T25, '"Segment" : ', T60, I10, ',')
2605 FORMAT ( T25, '"Air_Velocity" : ', T60, F10.2, ',')
2610 FORMAT ( T25, '"Reynolds_Number" : ', T56, E14.5, ',')
2612 FORMAT ( T25, '"Reynolds_Number" : ', T56, E14.5)
2615 FORMAT ( T25, '"Number_Of_Trains" : ', T60, I10)
2620 FORMAT ( T25, '"Line" :', T66,'true,')
2625 FORMAT ( T25, '"Line" :', T65,'false,')
!     SUBSEGMENT DATA
2700 FORMAT ( T25, '"Subsegment_ID" :               "', I1, ' -', &
  &I3, ' -', I3, '",')
2701 FORMAT ( T25, '"Subsegment_ID" :              "', I2, ' -', I3, &
  &' -', I3, '",')
2702 FORMAT ( T25, '"Subsegment_ID" :             "', I3, ' -', I3, &
  &' -', I3, '",')
2705 FORMAT ( T25, '"Air_Temp" : ', T60, F10.2, ',')
2710 FORMAT ( T25, '"Wall_Temp" : ', T60, F10.2, ',')
2715 FORMAT ( T25, '"Humidity" : ', T58, F12.5, ',')
2720 FORMAT ( T25, '"Heat_Transfer_Coeff" : ', T57, F13.7, ',')
2725 FORMAT ( T25, '"Sensible" : ', T58, F12.3, ',')
2730 FORMAT ( T25, '"Latent" : ', T58, F12.3, ',')
2735 FORMAT ( T25, '"Qwalss" : ', T60, F10.2, ',')
2740 FORMAT ( T25, '"Qradss" : ', T60, F10.2, ',')
2745 FORMAT ( T25, '"Sensible_Ac" : ', T60, F10.2, ',')
2750 FORMAT ( T25, '"Latent_Ac" : ', T60, F10.2)
!
!
ZERO=0
REALZERO=0.0
LASTPIT=0
!     WRITE OUT THE PIT HEADER DATA
!     THE SIMULATION TIME
WRITE (JSON, 1300)
WRITE (JSON, 1500) FLOAT(NTIME)/100.0
!
!     TRAIN DATA
!     BEGIN TRAINS DATA BLOCK
IF (NTRAN .EQ. 0) THEN
WRITE (JSON, 2020)
GOTO 245
ELSE
WRITE(JSON, 2000)
WRITE(JSON, 1800)
ENDIF
!     LOOP OVER OPERATING TRAINS AND WRITE DATA RECORDS
DO 240 I=1,NTRAN
NUMV = IINDEX(I)
ITYP=ITYPV(NUMV)
U=UV(NUMV)*FPSMPH
IF( (ABS(U)-0.1) .LE. 0.0) THEN
CDV = 0.0
ELSE
CDV = 2.0*DRAGV(NUMV)/(RHOMAS*AV(ITYP)*UV(NUMV)*UV(NUMV))
ENDIF
NPASSENGERS = INT(WPATV(NUMV)/PATWHT)
HETGEN=QAXSV(NUMV)+(QACCV(NUMV)+QDECV(NUMV)+RMHTV(NUMV))/LV(ITYP)
QTRPF=QPRPV(NUMV) + QAXSV(NUMV)
!     WRITE OUT TRAIN DATA OBJECTS
WRITE (JSON, 1600)
WRITE (JSON, 2400) TRAINID(NUMV)
WRITE (JSON, 2402) TNUMV(NUMV)
WRITE (JSON, 2405) ITYPV(NUMV)
WRITE (JSON, 2410) IROTEV(NUMV)
WRITE (JSON, 2415) XV(NUMV)
WRITE (JSON, 2420) U
WRITE (JSON, 2425) DUDTV(NUMV) * FPSMPH
WRITE (JSON, 2430) MODEV(NUMV)
WRITE (JSON, 2435) RSISTV(NUMV)
WRITE (JSON, 2440) DRAGV(NUMV)
WRITE (JSON, 2445) TEV(NUMV)
WRITE (JSON, 2450) CDV
WRITE (JSON, 2455) AMPV(NUMV)
WRITE (JSON, 2460) AMPLV(NUMV)
WRITE (JSON, 2465) RPS(NUMV) * 60
WRITE (JSON, 2470) TGACCV(NUMV)
WRITE (JSON, 2472) TGDECV(NUMV)
WRITE (JSON, 2466) HETGEN
WRITE (JSON, 2467) QTRPF
WRITE (JSON, 2474) PAUXV(NUMV)
WRITE (JSON, 2476) PPROPV(NUMV)
WRITE (JSON, 2478) PREGNV(NUMV)
WRITE (JSON, 2480) PFLYV(NUMV)
WRITE (JSON, 2482) QACCV(NUMV)
WRITE (JSON, 2484) QDECV(NUMV)
WRITE (JSON, 2486) RMHTV(NUMV)
WRITE (JSON, 2488) QPRPV(NUMV)
WRITE (JSON, 2490) QAXSV(NUMV)
WRITE (JSON, 2492) QAXLV(NUMV)
WRITE (JSON, 2494) NPASSENGERS
!     CLOSE OUT EACH TRAIN DATA BLOCK WITH A COMMA OR NOT
!     IF NOT LAST TRAIN, PRINT A COMMA.  ON LAST TRAIN, NO COMMA
!     CHECK IF LAST ITEM IN LOOP AND CLOSE CURLY BRACE
IF (I .LT. NTRAN) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
240 CONTINUE
!     CLOSE OUT THE LAST ITEM IN LIST OF TRAIN.  LEAD INTO SECTION DATA
WRITE (JSON, 1920)
!
!
!     SECTION DATA BEGIN
!     IF NO SYSTEM IS BEING SIMULATED WRITE EMPTY LISTS FOR SECT,SEG,SS
245 IF (NOSYS .EQ. 0) THEN
WRITE (JSON, 2110)
WRITE (JSON, 2210)
WRITE (JSON, 2310)
GOTO 999
ENDIF
!
!     SECTION DATA BEGIN
!     LOOP OVER SECTIONS
!
!     BEGIN SECTION DATA JSON KEY
!
!     CALCULATE NUMBER OF SEGMENTS (LINE AND VENT)
!     THIS COUNT IS USED FOR SECTION_DATA AND SEGMENT_DATA LIST CLOSURE
NSEGMENTS = NLS + NVSEC
WRITE (JSON, 2100)
WRITE (JSON, 1800)
!
!     CREATE A COUNTER (NUMY1) OF SECTION_DATA OBJECTS PROCESSED
NUMY1=0
IF (INPUT_UNITS .EQ. UNIT_SI) THEN
ALTER=RHOMAS
ELSE
ALTER=RHOMAS/WGCONS
ENDIF
DO  250  ISCTX = 1,LMSCTX
!---- CHECK IF SECTION I.D. NUMBER HAS BEEN USED
IF( TABL14(ISCTX) ) 250,250,247
247 ISCT = TABL14(ISCTX)
!     GET SECTION-TO-SEGMENT MAP FOR SECTION DATA OUTPUT
ISEGL = TABL9(ISCT)
ISEGH = TABL10(ISCT)
!     DUMY1 IS THE TOTAL PRESSURE CHANGE IN THE SECTION
DUMY1=ALTER*(OMEGS(ISCT)-BS(ISCT)*DQDTS(ISCT))
IF (INPUT_UNITS .EQ. UNIT_SI) THEN
Q = QSAVES(ISCT)
ELSE
Q = QSAVES(ISCT) * 60
ENDIF
!     WRITE SECTION DATA FOR EACH SEGMENT IN THIS SECTION
IF (ISEGL .LT. 0) THEN
!       VENTILATION SECTION: ONE SEGMENT PER SECTION
IVS = IABS(ISEGL)
NUMY1 = NUMY1 + 1
WRITE (JSON, 1600)
WRITE (JSON, 2500) ISCTX
WRITE (JSON, 2600) NUMVS(IVS)
WRITE (JSON, 2505) Q
WRITE (JSON, 2510) BUOYS(ISCT) * ALTER
WRITE (JSON, 2515) DUMY1
IF (NUMY1 .LT. NSEGMENTS) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
ELSE IF (ISEGL .GT. 0) THEN
!       LINE SECTION: REPEAT SECTION DATA FOR EACH LINE SEGMENT
DO 248 ILS = ISEGL, ISEGH
NUMY1 = NUMY1 + 1
WRITE (JSON, 1600)
WRITE (JSON, 2500) ISCTX
WRITE (JSON, 2600) NUMLS(ILS)
WRITE (JSON, 2505) Q
WRITE (JSON, 2510) BUOYS(ISCT) * ALTER
WRITE (JSON, 2515) DUMY1
IF (NUMY1 .LT. NSEGMENTS) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
248 CONTINUE
ENDIF
!
250 CONTINUE
!
!     CLOSE OUT THE LAST ITEM IN LIST OF SECTIONS. LEAD INTO SEG DATA
WRITE (JSON, 1920)
!     END SECTION DATA
!
!     BEGIN SEGMENT DATA

!     CREATE A COUNTER OF SEGMENTS PROCESSED (NUMY1)
NUMY1 = 0
!     SEGMENT DATA
WRITE (JSON, 2200)
WRITE (JSON, 1800)
!     LINE SEGMENTS
!     WRITE OUT SEGMENT DATA HEADER INFO
!
DO 300 ISCTX = 1, LMSCTX
IF( TABL14(ISCTX) ) 300,300,260
260 ISCT = TABL14(ISCTX)
ISEGL = TABL9(ISCT)
ISEGH = TABL10(ISCT)
IF (INPUT_UNITS .EQ. UNIT_SI) THEN
Q = QSAVES(ISCT)
ELSE
Q = QSAVES(ISCT) * 60
ENDIF
!     BRANCH ON VENT OR LINE SEGMENT
IF( ISEGL ) 280,300,270
!     LINE SECTION
270 DO  275  ILS = ISEGL,ISEGH
!     COUNT OF SEGMENTS ++
NUMY1 = NUMY1 + 1
V = Q / ALS(ILS)
K = NTRNLS(ILS)
!     OPEN CURLY BRACE
WRITE (JSON, 1600)
!
!     CREATE SEGEMENT ID.  TO AVOID LEADING SPACES IN JSON KEY, THREE
!     DIFFRENT FORMAT STATEMENTS ARE NEEDED (SINGLE DIGITS, DOUBLE
!     DIGITS, AND TRIPLE DIGIT SECTION NUMBERS.)
WRITE (JSON, 2600) NUMLS(ILS)
!
WRITE (JSON, 2620)
WRITE (JSON, 2605) V
WRITE (JSON, 2610) RELS(ILS)
WRITE (JSON, 2615) K
!     CHECK IF LAST ITEM IN LOOP AND CLOSE CURLY BRACE
!     ADD COMMA IS THERE ARE VENTS
!     GET COMPLICATED BECAUSE IF NO VENTS THEN NO COMMA
!
IF (NUMY1 .LT. NSEGMENTS) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
!
275 CONTINUE
GOTO 300
!
!     VENTILATION SECTION/SEGMENT
280 IVS = IABS( ISEGL )
V = Q / AVS(IVS)
!     COUNT OF SEGMENTS ++
NUMY1 = NUMY1 + 1
!     OPEN CURLY BRACE
WRITE (JSON, 1600)
!
!     CREATE SEGEMENT ID.  TO AVOID LEADING SPACES IN JSON KEY, THREE
!     DIFFRENT FORMAT STATEMENTS ARE NEEDED (SINGLE DIGITS, DOUBLE
!     DIGITS, AND TRIPLE DIGIT SECTION NUMBERS.)
WRITE (JSON, 2600) NUMVS(IVS)
!
WRITE (JSON, 2625)
WRITE (JSON, 2605) V
WRITE (JSON, 2612) REVS(IVS)
!     CHECK IF LAST ITEM IN LOOP AND CLOSE CURLY BRACE
IF (NUMY1 .LT. NSEGMENTS) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
!
300 CONTINUE
!
!     CLOSE OUT SEGMENT DATA
WRITE (JSON, 1920)
!     END OF SEGMENT DATA
!
!
!
!
!*****SUBSEGMENT DATA
IF ((THOPT*JRATTH).EQ.0) THEN
WRITE(JSON, 2310)
GOTO 999
ENDIF
!     BEGIN SUBSEGMENT DATA BLOCK
WRITE (JSON, 2300)
WRITE (JSON, 1800)
!     CREATE A COUNTER OF SUBSEGMENTS PROCESSED (NUMY2)
NUMY1 = 0
!     LOOP OVER SECTIONS
DO 350 ISCTX = 1, LMSCTX
!---- CHECK IF SECTION I.D. NUMBER HAS BEEN USED
IF( TABL14(ISCTX) ) 350,350,310
310 ISCT = TABL14(ISCTX)
ISEGL = TABL9(ISCT)
ISEGH = TABL10(ISCT)
IF( ISEGL ) 330,350,320
!     LINE SEGMENT
320 DO  325  ILS = ISEGL,ISEGH
ILSSL = TABL3(ILS)
ILSSH = TABL4(ILS)
!     NUMY2 IS EXTERNAL SUBSEGMENT NUMBER
NUMY2 = 0
DO 323 ISS = ILSSL, ILSSH
NUMY1 = NUMY1 + 1
NUMY2 = NUMY2 + 1
!     OPEN CURLY BRACE
WRITE (JSON, 1600)
!
!     CREATE SEGEMENT ID.  TO AVOID LEADING SPACES IN JSON KEY, THREE
!     DIFFRENT FORMAT STATEMENTS ARE NEEDED (SINGLE DIGITS, DOUBLE
!     DIGITS, AND TRIPLE DIGIT SECTION NUMBERS.)
IF ( ISCTX .LE. 9 ) THEN
WRITE (JSON, 2700) ISCTX, NUMLS(ILS), NUMY2
ELSE IF ( ISCTX .LE. 99 ) THEN
WRITE (JSON, 2701) ISCTX, NUMLS(ILS), NUMY2
ELSE
WRITE (JSON, 2702) ISCTX, NUMLS(ILS), NUMY2
END IF
!
WRITE (JSON, 2705) TDBSS(ISS)
WRITE (JSON, 2710) TSFSS(ISS)
WRITE (JSON, 2715) HUMSS(ISS)
WRITE (JSON, 2720) HTRNSS(ISS)
WRITE (JSON, 2725) SHLTSS(ISS)
WRITE (JSON, 2730) LHLTSS(ISS)
IF (FIROP2.LE.0) THEN
WRITE (JSON, 2735) REALZERO
WRITE (JSON, 2740) REALZERO
!     ADD FLAG TO INDICATE FIRE SEGMENT TO OUTPUT OR JUST LEAVE REALZERO
ELSE
WRITE (JSON, 2735) QWALSS(ISS)
WRITE (JSON, 2740) QRADSS(ISS)
END IF
WRITE (JSON, 2745) SACLSS(ISS)
WRITE (JSON, 2750) LACLSS(ISS)
!     CHECK IF LAST LINE SUBSEGMENTS AND CLOSE CURLY BRACE
IF (NUMY1 .LT. TNSS) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
323 CONTINUE
325 CONTINUE
GOTO 350
!     ====================
!     VENT SEGMENT
330 IVS = IABS( ISEGL )
IVSSL = TABL5(IVS)
IVSSH = TABL6(IVS)
!     NUMY2 IS EXTERNAL SUBSEGMENT NUMBER
NUMY2 = 0
DO 335 ISS = IVSSL, IVSSH
NUMY1 = NUMY1 + 1
NUMY2 = NUMY2 + 1
!     OPEN CURLY BRACE
WRITE (JSON, 1600)
!
!     CREATE SEGEMENT ID.  TO AVOID LEADING SPACES IN JSON KEY, THREE
!     DIFFRENT FORMAT STATEMENTS ARE NEEDED (SINGLE DIGITS, DOUBLE
!     DIGITS, AND TRIPLE DIGIT SECTION NUMBERS.)
IF ( ISCTX .LE. 9 ) THEN
WRITE (JSON, 2700) ISCTX, NUMVS(IVS), NUMY2
ELSE IF ( ISCTX .LE. 99 ) THEN
WRITE (JSON, 2701) ISCTX, NUMVS(IVS), NUMY2
ELSE
WRITE (JSON, 2702) ISCTX, NUMVS(IVS), NUMY2
END IF
!
WRITE (JSON, 2705) TDBSS(ISS)
WRITE (JSON, 2710) TSFSS(ISS)
WRITE (JSON, 2715) HUMSS(ISS)
WRITE (JSON, 2720) HTRNSS(ISS)
WRITE (JSON, 2725) REALZERO
WRITE (JSON, 2730) REALZERO
WRITE (JSON, 2735) REALZERO
WRITE (JSON, 2740) REALZERO
WRITE (JSON, 2745) REALZERO
WRITE (JSON, 2750) REALZERO
!     CHECK IF LAST LINE SUBSEGMENTS AND CLOSE CURLY BRACE
IF (NUMY1 .LT. TNSS) THEN
WRITE (JSON, 1720)
ELSE
WRITE (JSON, 1700)
ENDIF
335 CONTINUE
!
350 CONTINUE
!
!     CLOSE OUT SUBSEGMENT DATA
WRITE (JSON, 1900)
!
!     PRINT OUT FIRE SEGMENT DATA TO JSON OBJECT EVEN THOUGH THIS DATA
!     IS ALREADY INCLUDED IN SUBSEGMENT DATA (CONVECTIVE AND RADIATIVE
!     OUTPUT FOR FIRE SEGMENTS)  [TO BE DONE IF NECESSARY TPO]
!
!     CLOSE OUT PIT IN JSON FILE AND CLOSE CURLY BRACKETS/PARENTHESES
!     CHECK IF LAST PIT
999 IF (NEW .EQ. 2) LASTPIT=1
IF (NTIME .GE. MAXTIM) LASTPIT=1
IF (LASTPIT .EQ. 1) THEN
!     LAST PRINT...CLOSE LIST OUT
WRITE (JSON, 1320)
WRITE (JSON, 1220)
ELSE
!     NOT LAST PRINT
WRITE (JSON, 1340)
ENDIF
RETURN
END
